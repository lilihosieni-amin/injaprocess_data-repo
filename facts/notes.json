          "run": "runs/facts/cooking/20260909-131845"
        }
      ],
      "retired": false,
      "data": {
        "about": [
          {
            "ref": "F-00079"
          }
        ],
        "question": "سهم سیب‌زمینی هر پک اینجا باکس چقدر است و بر چه مبنایی شمرده می‌شود؟"
      },
      "id": "F-00218",
      "valid_from": null,
      "valid_to": null,
      "status": "confirmed",
      "updated_at": "2026-09-09T14:05:54Z"
