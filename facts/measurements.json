          "run": "runs/facts/preparation/20260919-060128"
        }
      ],
      "retired": false,
      "data": {
        "quantity": "other",
        "unit": null,
        "of": "کیفیت هر قلم تولیدی آماده‌سازی",
        "method": "چشیدن و بررسی ظاهر هر قلم بسته‌بندی‌شده، و پخت و چشیدن یک نمونه از فرآورده‌های گوشتی مانند برگر، گوشت چرخ‌کرده و رست‌بیف",
        "when": "هر روز، و برای هر فرآوردهٔ گوشتی در همان روزی که تولید می‌شود",
        "by": "سرپرست آماده‌سازی",
        "exceptions": "سس‌های دست‌ساز ماهی یک تا دو بار تولید می‌شوند و کنترل آن‌ها در همان نوبت تولید و با حضور سرپرست انجام می‌شود."
      },
