          "run": "runs/facts/cooking/20260908-151433"
        }
      ],
      "retired": false,
      "data": {
        "about": [
          {
            "ref": "F-00165"
          }
        ],
        "question": "آیا مقدار ضایعات غیرمحصول که در فرم کاغذی نوشته و به انبار تحویل می‌شود در همین ثبت هم وارد می‌شود یا این دو ثبت جدا از هم‌اند؟"
      },
      "id": "F-00224",
      "valid_from": null,
      "valid_to": null,
      "status": "confirmed",
      "updated_at": "2026-09-08T16:53:00Z"
