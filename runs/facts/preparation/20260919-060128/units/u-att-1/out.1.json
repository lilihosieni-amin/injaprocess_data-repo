{"kind":"record","key":"tabdil_amadesazi__kenar_shenisel","title":"فرم تبدیل آماده‌سازی کنار شنیسل","statement":"برگهٔ کاغذی آماده‌سازی برای ثبت تبدیل کنار شنیسل پخته؛ سه ستون کاست، ضایعات شنیسل و مرغ پخته هر یک بر حسب کیلو و در پایین تاریخ و وزن بر حسب کیلو. کنار شنیسل هفته‌ای یک روز پخته می‌شود و مرغ قابل استفادهٔ آن به مرغ پیتزای پخته تبدیل می‌شود.","data":{"medium":"paper","location":{"kept_at":"بخش آماده‌سازی","holder":"مسئول لاین مرغ"},"role":"log","grain":"هر برگه یک نوبت پخت کنار شنیسل","cadence":"weekly","filled_by":"مسئول لاین مرغ","approved_by":"سرپرست آماده‌سازی","header_fields":[{"key":"tarikh","title":"تاریخ","type":"date","unit":null},{"key":"vazn","title":"کیلو","type":"number","unit":"کیلو"}],"fields":[{"key":"kast","title":"کاست","type":"number","unit":"کیلو"},{"key":"zayeat_shenisel","title":"ضایعات شنیسل","type":"number","unit":"کیلو"},{"key":"morgh_pokhte","title":"مرغ پخته","type":"number","unit":"کیلو"}],"sections":[{"key":"kenar_shenisel","title":"کنار شنیسل"}],"blank_master":true},"processes":[{"process":"preparation-013","node":"preparation-013-n062","quote":"وزن‌کشی مرغ پخته حاصل از کنار شینسل و تکمیل فرم تبدیل کنار شینسل"}],"extra":{"from":["departments/preparation/attachments/.text/photo-AQADdw5rG7piKFF-.image.md"],"voice":[{"ref":"meetings/transcripts/preparation-1405-06-04.txt","lines":"101-260"}]}},

