    {
      "kind": "record",
      "key": "form_darkhast_kala_amadesazi",
      "title": "برگهٔ درخواست کالای روزانهٔ آماده‌سازی",
      "statement": "برگهٔ کاغذی دوبرگی که حدود صد قلم نیاز همیشگی روزانهٔ آماده‌سازی از انبار (ادویه، سس، لبنیات، سبزی و اقلام مصرفی غیرخوراکی) را با واحد چاپ‌شدهٔ هر قلم فهرست می‌کند. مسئول هر لاین غروب کسری لاین خود را در ستون مقدار درخواست می‌نویسد و سرپرست آماده‌سازی آن را بازبینی و تأیید می‌کند و پیش از ساعت شش و نیم حضوری تحویل انبار می‌دهد. انبار مقدار تحویلی را ثبت و تیک می‌زند و صبح روز بعد همان برگه برای اصلاح به آماده‌سازی برمی‌گردد و اصلاح‌شده دوباره تحویل انبار می‌شود.",
      "aliases": [
        "چک‌لیست غروب آماده‌سازی",
        "درخواست کالا بخش آماده سازی",
        "لیست درخواست کالای آماده‌سازی",
        "لیست ثانویه درخواست کالا"
      ],
      "processes": [
        {"process": "preparation-003", "node": "preparation-003-n002", "quote": "چک‌لیست غروب آماده‌سازی چیزی حدود صد قلم جنس است"},
        {"process": "preparation-003", "node": "preparation-003-n004", "quote": "یک دور فرم نهایی را نگاه می‌اندازد و تأییدش را می‌زند"},
        {"process": "preparation-003", "node": "preparation-003-n005", "quote": "خود سرپرست چک‌لیست را به انبار می‌برد"},
        {"process": "preparation-003", "node": "preparation-003-n008", "quote": "انبار هم هر قلمی را که می‌دهد روی همین فرم تیک می‌زند"},
        {"process": "preparation-003", "node": "preparation-003-n009", "quote": "با بی‌سیم به انبار اعلام می‌شود"},
        {"process": "preparation-003", "node": "preparation-003-n012", "quote": "اصلاحیه روی همان فرمی انجام می‌شود که شب قبل تحویل انبار شده"},
        {"process": "preparation-016", "node": "preparation-016-n002", "quote": "آن را به فرم اضافه می‌کند تا برای آماده‌سازی بالا بیاورند"},
        {"process": "warehouse-023", "node": "warehouse-023-n001", "quote": "روی فرم درخواست کالا در برگهٔ آ۴ می‌نویسد و تحویل انبار می‌دهد"},
        {"process": "warehouse-012", "node": "warehouse-012-n002", "quote": "وزن اقلام وزنی و تعداد اقلام عددی در همان فرم درخواست کالا درج می‌شود"},
        {"process": "warehouse-012", "node": "warehouse-012-n009", "quote": "یک ستون برای مقدار درخواست‌شده و یک ستون برای مقدار تحویل انبار دارد"}
